# ── Neon Postgres ──────────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/sarasmer?sslmode=require"
# Direct (unpooled) connection — used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/sarasmer?sslmode=require"

# ── Auth.js (NextAuth v5) ──────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Optional — Google OAuth. Leave empty to hide the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
